---
import BaseLayout from './BaseLayout.astro';
const { title, description, publishedAt, tags = [] } = Astro.props;
const date = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long' }).format(publishedAt);
const isConcept = tags.includes('Concept');
const visibleTags = tags.filter((tag) => tag !== 'Concept');
---
<BaseLayout title={`${title} | 잠탱이 Dev Lab`} description={description}>
  <article class="prose">
    <div class="eyebrow">{isConcept ? 'Technology Note' : 'Engineering Log'}</div>
    <h1>{title}</h1>
    <p class="meta">{date} · {visibleTags.join(' · ')}</p>
    <p class="lead">{description}</p>
    <hr />
    <slot />
  </article>
</BaseLayout>
