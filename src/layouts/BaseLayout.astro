---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = '잠탱이 Dev Lab | Build · Learn · Record',
  description = 'AI, Backend, Architecture를 직접 구현하며 배우고, 프로젝트 경험과 반복해서 볼 기술 개념을 기록하는 개인 개발 지식 베이스'
} = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
