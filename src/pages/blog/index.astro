---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.tags.includes('Concept')))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="개발 기록 | 잠탱이 Dev Lab" description="프로젝트 구현, 문제 해결, 설계 판단, 테스트와 시행착오를 기록합니다.">
  <header class="page-head container">
    <div class="eyebrow">Engineering Log</div>
    <h1>개발 기록</h1>
    <p class="lead">특정 프로젝트에 한정하지 않고 직접 구현한 과정, 문제 해결, 설계 판단과 테스트 결과를 남깁니다. 프로젝트가 달라져도 경험과 판단 근거가 이어지도록 기록합니다.</p>
  </header>
  <section class="container post-list">
    {posts.map((post) => (
      <a class="post-row" href={`${base}blog/${post.id}/`}>
        <div class="meta">{post.data.publishedAt.toLocaleDateString('ko-KR')}</div>
        <div><h2>{post.data.title}</h2><p class="lead">{post.data.description}</p><div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div>
      </a>
    ))}
  </section>
</BaseLayout>
