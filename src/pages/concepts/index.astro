---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.tags.includes('Concept')))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="핵심 개념 | 잠탱이 AI Dev Lab" description="AI 핵심 개념을 정리합니다.">
  <header class="page-head container">
    <div class="eyebrow">AI Core Concepts</div>
    <h1>핵심 개념</h1>
    <p class="lead">Embedding, Vector Search, RAG, Tool Calling, Agent, MCP처럼 반복해서 참고할 개념을 별도로 정리합니다.</p>
  </header>
  <section class="container post-list">
    {posts.map((post) => (
      <a class="post-row" href={`${base}blog/${post.id}/`}>
        <div class="meta">{post.data.publishedAt.toLocaleDateString('ko-KR')}</div>
        <div><h2>{post.data.title}</h2><p class="lead">{post.data.description}</p></div>
      </a>
    ))}
  </section>
</BaseLayout>
